generator client {
  provider      = "prisma-client-js"
  output        = "./generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  telegramId            String?   @unique
  name                  String?
  password              String
  role                  String    @default("USER")
  onboarded             Boolean   @default(false)
  requiresPasswordReset Boolean   @default(false)
  gender                String?
  age                   Int?
  weight                Float?
  height                Float?
  timezone              String    @default("UTC")
  dailyCaloriesGoal     Int?
  dailyProteinGoal      Int?
  dailyCarbsGoal        Int?
  dailyFatGoal          Int?
  dailyWaterGoal        Int       @default(2750)
  mealLogs              MealLog[]
  reminders             Reminder[]
  hydrationSetting      HydrationSetting?
  hydrationLogs         HydrationLog[]
  sessions              Session[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
  obligations           Obligation[]
  obligationOccurrences ObligationOccurrence[]
  reminderDeliveries    ReminderDelivery[]
  personalDebts         PersonalDebt[]
  loans                 Loan[]
  loanPayments          LoanPayment[]
  wishlistItems         WishlistItem[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MealLog {
  id            String     @id @default(cuid())
  userId        String
  category      String
  time          String
  imagePath     String?
  description   String?
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFat      Float
  totalFiber    Float
  totalSatFat   Float
  totalSugar    Float
  healthInsight String?
  items         FoodItem[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

model FoodItem {
  id           String   @id @default(cuid())
  mealLogId    String
  name         String
  grams        Float
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  fiber        Float
  saturatedFat Float
  sugar        Float
  rating       Int?
  mealLog      MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([mealLogId])
}

model Reminder {
  id                 String             @id @default(cuid())
  userId             String
  domain             String             @default("HEALTH") // HEALTH | FINANCE
  type               String             @default("MEAL")   // MEAL | HYDRATION | GENERIC | OBLIGATION
  title              String             @default("")
  category           String?
  time               String?
  timeOfDay          String?
  scheduledAt        DateTime?
  recurrenceType     String?
  recurrenceInterval Int?
  activeDays         String[]           @default([])
  reminderOffsetsMin Int[]              @default([0])
  isActive           Boolean            @default(true)
  obligationId       String?
  mealCategory       String?
  snoozedUntil       DateTime?
  lastTriggeredAt    DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation         Obligation?        @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  deliveries         ReminderDelivery[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, isActive])
  @@index([userId, domain])
  @@index([obligationId])
}

model FinancialAccount {
  id             String                 @id @default(cuid())
  userId         String
  name           String
  type           String                 // BANK | CASH | WALLET | CREDIT_CARD
  institution    String?
  openingBalance Decimal                @default(0) @db.Decimal(14, 2)
  creditLimit    Decimal?               @db.Decimal(14, 2)
  isActive       Boolean                @default(true)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   FinancialTransaction[] @relation("AccountTransactions")
  transfersTo    FinancialTransaction[] @relation("TransferAccountTransactions")
  obligations    Obligation[]
  loans          Loan[]
  loanPayments   LoanPayment[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId, isActive])
  @@index([userId, type])
}

model FinancialTransaction {
  id                   String                @id @default(cuid())
  userId               String
  type                 String                // INCOME | EXPENSE | TRANSFER
  amount               Decimal               @db.Decimal(14, 2)
  category             String
  occurredAt           DateTime
  accountId            String
  transferAccountId    String?
  obligationId         String?
  note                 String?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              FinancialAccount      @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount      FinancialAccount?     @relation("TransferAccountTransactions", fields: [transferAccountId], references: [id], onDelete: SetNull)
  obligation           Obligation?           @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  obligationOccurrence ObligationOccurrence?
  personalDebtId       String?
  personalDebt         PersonalDebt?         @relation(fields: [personalDebtId], references: [id], onDelete: SetNull)
  loanPayment          LoanPayment?
  wishlistItem         WishlistItem?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId, occurredAt(sort: Desc)])
  @@index([accountId])
  @@index([transferAccountId])
  @@index([obligationId])
  @@index([personalDebtId])
}

model Obligation {
  id                 String                 @id @default(cuid())
  userId             String
  title              String
  kind               String                 // RECHARGE | CREDIT_CARD | BILL | SUBSCRIPTION | RENT | EMI | INSURANCE | OTHER
  amount             Decimal?               @db.Decimal(14, 2)
  accountId          String?
  dueAt              DateTime
  recurrenceType     String                 // ONCE | DAILY | WEEKLY | MONTHLY | YEARLY | EVERY_N_DAYS
  recurrenceInterval Int?
  reminderOffsetsMin Int[]                  @default([0])
  isActive           Boolean                @default(true)
  isArchived         Boolean                @default(false)
  notes              String?
  lastCompletedAt    DateTime?
  nextDueAt          DateTime
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            FinancialAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactions       FinancialTransaction[]
  occurrences        ObligationOccurrence[]
  reminders          Reminder[]
  deliveries         ReminderDelivery[]
  loan               Loan?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId, isActive])
  @@index([userId, nextDueAt])
}

model ObligationOccurrence {
  id            String                @id @default(cuid())
  userId        String
  obligationId  String
  occurrenceKey String
  dueDate       DateTime
  status        String                @default("COMPLETED") // COMPLETED | SKIPPED
  paidAt        DateTime              @default(now())
  transactionId String?               @unique
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligation    Obligation            @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  loanPayment   LoanPayment?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([obligationId, occurrenceKey])
  @@index([userId])
}

model ReminderDelivery {
  id                String      @id @default(cuid())
  userId            String
  reminderId        String
  obligationId      String?
  occurrenceKey     String
  scheduledFor      DateTime
  offsetMinutes     Int
  channel           String      @default("TELEGRAM") // TELEGRAM | APP
  status            String      @default("PENDING")  // PENDING | SENT | ACKNOWLEDGED | SNOOZED | FAILED
  telegramMessageId Int?
  failureReason     String?
  attemptCount      Int         @default(0)
  lastAttemptAt     DateTime?
  nextRetryAt       DateTime?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  snoozedUntil      DateTime?
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder          Reminder    @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  obligation        Obligation? @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([reminderId, occurrenceKey, offsetMinutes, channel])
  @@index([userId, status])
  @@index([scheduledFor])
  @@index([obligationId])
}

model HydrationSetting {
  id              String   @id @default(cuid())
  userId          String   @unique
  startTime       String
  endTime         String
  intervalMinutes Int
  activeDays      String[]
  isActive        Boolean  @default(true)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HydrationLog {
  id        String   @id @default(cuid())
  userId    String
  amountMl  Int
  drinkType String   @default("Water")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model PersonalDebt {
  id                 String                 @id @default(cuid())
  userId             String
  direction          String                 // RECEIVABLE | PAYABLE
  counterpartyName   String
  title              String?
  originalAmount     Decimal                @db.Decimal(14, 2)
  startedAt          DateTime               @default(now())
  dueAt              DateTime?
  reminderOffsetsMin Int[]                  @default([0])
  status             String                 @default("OPEN") // OPEN | SETTLED | ARCHIVED
  notes              String?
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       FinancialTransaction[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([userId, status])
  @@index([userId, dueAt])
}

model Loan {
  id                         String            @id @default(cuid())
  userId                     String
  name                       String
  loanType                   String            // PERSONAL | HOME | VEHICLE | EDUCATION | GOLD | PRODUCT_EMI | CREDIT_CARD_EMI | OTHER
  lender                     String
  originalPrincipal          Decimal?          @db.Decimal(14, 2)
  openingOutstanding         Decimal           @db.Decimal(14, 2)
  outstandingPrincipal       Decimal           @db.Decimal(14, 2)
  trackedFromAt              DateTime          @default(now())
  emiAmount                  Decimal?          @db.Decimal(14, 2)
  emiGeneratesExpense        Boolean           @default(true)
  principalAlreadyRecognized Boolean           @default(false)
  interestRatePercent        Decimal?          @db.Decimal(5, 2)
  interestRateType           String            @default("UNKNOWN") // FIXED | FLOATING | UNKNOWN
  tenureMonths               Int?
  startDate                  DateTime?
  expectedEndDate            DateTime?
  nextEmiDate                DateTime?
  dueDay                     Int?
  paymentAccountId           String?
  productName                String?
  merchant                   String?
  obligationId               String?           @unique
  status                     String            @default("ACTIVE") // ACTIVE | CLOSED | ARCHIVED
  notes                      String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount FinancialAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  obligation     Obligation?       @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  payments       LoanPayment[]

  @@index([userId, status])
  @@index([userId, nextEmiDate])
}

model LoanPayment {
  id                     String                 @id @default(cuid())
  userId                 String
  loanId                 String
  amount                 Decimal                @db.Decimal(14, 2)
  principalPaid          Decimal?               @db.Decimal(14, 2)
  interestPaid           Decimal?               @db.Decimal(14, 2)
  feesPaid               Decimal?               @db.Decimal(14, 2)
  occurredAt             DateTime
  accountId              String
  transactionId          String?                @unique
  obligationOccurrenceId String?                @unique
  note                   String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan                 Loan                  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  account              FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction          FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  obligationOccurrence ObligationOccurrence? @relation(fields: [obligationOccurrenceId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([loanId, occurredAt(sort: Desc)])
}

model WishlistItem {
  id               String                @id @default(cuid())
  userId           String
  name             String
  category         String
  targetPrice      Decimal               @db.Decimal(14, 2)
  maxBudget        Decimal?              @db.Decimal(14, 2)
  priority         String                @default("MEDIUM") // LOW | MEDIUM | HIGH
  targetDate       DateTime?
  plannedAccountId String?
  status           String                @default("WISHLIST") // WISHLIST | PLANNED | READY | PURCHASED | ARCHIVED
  notes            String?
  actualPrice      Decimal?              @db.Decimal(14, 2)
  purchasedAt      DateTime?
  transactionId    String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedAccount FinancialAccount?     @relation(fields: [plannedAccountId], references: [id], onDelete: SetNull)
  transaction    FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, targetDate])
}
